# =============================================================================
# Dockerfile.airflow
# Custom Airflow image with Java 17 + PySpark + dbt + PostgreSQL JDBC driver
# Base: apache/airflow:2.7.3-python3.11
# Author: Juan Pedro Ferreira — Qversity 2026 Montevideo
# =============================================================================

FROM apache/airflow:2.7.3-python3.11

USER root

# ── Install Java 17 (required by PySpark) ────────────────────────────────────
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openjdk-17-jdk-headless \
        curl \
        wget \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Set Java environment variables ───────────────────────────────────────────
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# ── Download PostgreSQL JDBC driver ──────────────────────────────────────────
RUN mkdir -p /opt/spark/jars && \
    wget -q https://jdbc.postgresql.org/download/postgresql-42.7.3.jar \
         -O /opt/spark/jars/postgresql-42.7.3.jar

# ── Switch back to airflow user for pip installs ──────────────────────────────
USER airflow

# ── Install Python dependencies ───────────────────────────────────────────────
RUN pip install --no-cache-dir \
    pyspark==3.5.0 \
    dbt-core==1.7.17 \
    dbt-postgres==1.7.17 \
    psycopg2-binary==2.9.9 \
    pandas==2.2.2 \
    requests==2.31.0 \
    boto3==1.34.69
